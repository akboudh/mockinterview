DATABASE_URL=data/mockinterview.sqlite

# LLM: deterministic needs no keys; openai / gemini need keys below.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# POST /transcribe (dictation)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# POST /speech (read questions aloud)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=mockinterview

# Base URL for this deployment. For split dev, student is usually 3000 and mentor 3001 — match the process you care about, or leave student URL here.
NEXT_PUBLIC_APP_URL=http://student.localhost:3000

# --- Split: mentor dashboard on another origin (npm run dev:student + dev:mentor, or dev:both) ---
# Do NOT set APP_SURFACE here — dev scripts / Docker set it per process.
# Cross-app login links; student server redirects /mentor/* to MENTOR_APP_URL.
MENTOR_APP_URL=http://mentor.localhost:3001
STUDENT_APP_URL=http://student.localhost:3000
# Optional: same values exposed to the browser (e.g. static export edge cases)
# NEXT_PUBLIC_MENTOR_APP_URL=http://mentor.localhost:3001
# NEXT_PUBLIC_STUDENT_APP_URL=http://student.localhost:3000

# Auth: roles are stored on the account only (no env-based role merge at login).
# MENTOR_EMAILS / mentor signup code only gate who may create a mentor account.
MENTOR_EMAILS=
ADMIN_EMAILS=
MENTOR_SIGNUP_CODE=mentor-dev-access

GUARDRAIL_PROVIDER=local
GUARDRAIL_API_URL=
GUARDRAIL_API_KEY=
GUARDRAIL_TIMEOUT_MS=4000
GUARDRAIL_POLICY_PATH=

## Realtime (recommended for split dev: student + mentor in two processes)
# Start Redis (one-liner): `docker run --rm -p 6379:6379 redis:7-alpine`
REDIS_URL=redis://localhost:6379

## SQLite (helps when 2 Next processes share one DB file)
# SQLITE_BUSY_MS=60000

AI_REQUEST_TIMEOUT_MS=
